# Postgres es el motor pensado para uso real (ver README).
DATABASE_URL=postgresql+psycopg://scoreboard:scoreboard@localhost:5432/scoreboard

# Alternativa para probar el proyecto sin instalar Postgres:
# DATABASE_URL=sqlite:///./dev.db

# Acepta lista separada por comas (más cómodo en un panel de env vars de un
# PaaS) o JSON como acá abajo -- los dos formatos funcionan.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=https://tu-frontend.onrender.com,https://tudominio.com

# --- Auth ---
# OBLIGATORIO: firma los JWT de sesión. La app se niega a arrancar si esto
# se deja en el valor de ejemplo o tiene menos de 32 caracteres (ver
# app/core/config.py::validar_secret_key) -- generar una real con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-aleatorio-de-al-menos-32-caracteres

# --- Notificaciones por email (opcional, global) ---
# Sin estas variables, las notificaciones solo se crean in-app (no falla
# nada, simplemente no sale ningún email). Ver app/services/notificaciones.py.
# Es global (un solo mailbox del operador) porque cada email va a un
# destinatario específico -- no mezcla organizaciones como sí lo haría un
# Slack global (ver abajo).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=una-app-password-real
# SMTP_FROM=notificaciones@tuempresa.com

# --- Notificaciones a Slack ---
# NO va acá -- es por organización (cada una configura su propio webhook
# desde Equipo > Notificaciones a Slack en la UI, o PATCH /organizacion).
# Un webhook global mandaría las notificaciones de todas las organizaciones
# al mismo canal, mezclando nombres de sectores y usuarios de empresas
# distintas.

# --- Rate limiting de la API pública (por API key) ---
API_RATE_LIMIT_POR_MINUTO=60

# --- Proxy de confianza (Render, Railway, cualquier PaaS con load balancer) ---
# Sin esto, request.client.host es la IP INTERNA del proxy para TODO el
# tráfico externo, y el rate limit por IP terminaría tratando a todos los
# usuarios como uno solo. Actívalo SOLO si de verdad hay un proxy de este
# tipo delante de la app -- si la app recibe tráfico directo de internet,
# activar esto permite que cualquiera falsifique su IP con el header
# X-Forwarded-For y se salte el límite. En local, dejar en false.
TRUST_PROXY_HEADERS=false
